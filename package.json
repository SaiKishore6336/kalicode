{
  "name": "kalicode",
  "productName": "KaliCode",
  "version": "1.0.0",
  "description": "A fast, Kali-native code workspace with Monaco, Git, search, and an integrated terminal.",
  "main": "electron/main.cjs",
  "author": "Sai Kishore",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/SaiKishore6336/kalicode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaiKishore6336/kalicode.git"
  },
  "bugs": {
    "url": "https://github.com/SaiKishore6336/kalicode/issues"
  },
  "keywords": [
    "electron",
    "editor",
    "ide",
    "monaco",
    "terminal",
    "git",
    "kali-linux",
    "desktop"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "rebuild": "vite build && electron .",
    "dev:web": "vite",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs",
    "install:app": "bash install.sh",
    "install-desktop": "bash scripts/install-desktop-entry.sh",
    "build:deb": "bash scripts/build-deb.sh"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "vite": "^7.1.7"
  }
}
